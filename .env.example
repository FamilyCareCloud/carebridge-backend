PORT=3000
DATA_FILE=./data/fcc-v2.json
AI_PROVIDER=local
AWS_REGION=ap-northeast-2
# Bedrock 사용 시 AI_PROVIDER=bedrock 및 접근 가능한 모델 ID 설정
BEDROCK_MODEL_ID=
# fcc-ai(GPU STT, feature/stt-service)를 로컬 uvicorn 또는 터널(예: Cloudflare Tunnel/ngrok)로 노출한 주소. 비워두면 음성 질문 API는 503을 반환합니다.
STT_SERVICE_URL=http://127.0.0.1:8000
# 공인 터널로 노출할 때 fcc-ai에도 같은 값을 FCC_AI_API_KEY로 설정하세요. 비워두면 헤더를 보내지 않습니다.
STT_SERVICE_API_KEY=
STT_TIMEOUT_MS=15000
# base64 인코딩된 오디오 요청 본문의 최대 바이트 수(기본 4MB)
AUDIO_MAX_BYTES=4194304
# Lambda 환경은 SAM 템플릿에서 자동 주입
DYNAMODB_TABLE=
COGNITO_CLIENT_ID=

# Cognito 계정 상태 조회 (SAM에서 자동 주입)
COGNITO_USER_POOL_ID=

# CareBridge: service key stays in the backend
CAREBRIDGE_SERVICE_URL=http://127.0.0.1:8002
CAREBRIDGE_SERVICE_API_KEY=
CAREBRIDGE_TIMEOUT_MS=22000

# 기관 업무 v1 로컬 정책. docs/WORKSPACE_API.md 참고
CAREBRIDGE_MULTIPLE_WORKSPACES=false
CAREBRIDGE_TRANSFER_ENABLED=true
CAREBRIDGE_CONFIRMATION_ENABLED=true
# 확정 정책: 기존 공개 전체 차단 후 재공개
CAREBRIDGE_RECIPIENT_CHANGE=block_all

# 로컬 QA 전용. 실제 비밀번호는 별도로 전달하고 저장소에 기록하지 않음
CAREBRIDGE_TEST_ADMIN_ENABLED=false
CAREBRIDGE_TEST_ADMIN_PASSWORD=
# 미지정 시 합성 QA 기관을 자동 생성. 지정 시 해당 기관에만 접근
CAREBRIDGE_QA_WORKSPACE_IDS=
